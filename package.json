{
  "name": "aquatrack-backend",
  "version": "1.0.0",
  "description": "Backend API for AquaTrack - Water Intake Tracker App",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mem": "tsx src/scripts/devWithMemoryDb.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "verify": "npm run lint && npm run build && npm test",
    "seed:admin": "tsx src/scripts/seedAdmin.ts"
  },
  "keywords": [
    "aquatrack",
    "water-intake",
    "express",
    "mongodb",
    "typescript"
  ],
  "author": "Chandradeep",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
